# Remote Operations / Mobile Command Center
BELTU_REMOTE_USER=beltu
BELTU_REMOTE_PASSWORD=change-me
BELTU_REMOTE_SECRET=replace-with-32+-random-characters
BELTU_REMOTE_HOST=127.0.0.1
BELTU_REMOTE_PORT=8765
BELTU_REMOTE_TTL_SECONDS=43200
BELTU_REMOTE_SCOPES=read,chat,control,approve
BELTU_REMOTE_CORS=

# Local FreeToken runtime
BELTU_FREETOKEN_URL=http://127.0.0.1:8000
BELTU_FREETOKEN_MODEL=/absolute/path/to/local/model
BELTU_FREETOKEN_PORT=8000
BELTU_FREETOKEN_HOST=127.0.0.1
BELTU_FREETOKEN_PID_FILE=data/runtime/freetoken.pid
BELTU_FREETOKEN_MEMORY_RATIO=0.80
BELTU_FREETOKEN_MAX_RUNNING_REQUESTS=1
BELTU_FREETOKEN_MOE_BACKEND=auto

# Optional SMTP report delivery
BELTU_SMTP_HOST=
BELTU_SMTP_PORT=465
BELTU_SMTP_USER=
BELTU_SMTP_PASSWORD=
BELTU_SMTP_FROM=
BELTU_SMTP_SSL=true
